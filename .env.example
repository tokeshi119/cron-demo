# ============================================
# ローカル開発用環境変数
# ============================================

# PostgreSQL設定（Docker Compose使用時）
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cron_larning
POSTGRES_PORT=5432

# アプリケーション設定
NODE_ENV=development
PORT=3002
FRONTEND_URL=http://localhost:3003

# データベース接続URL
# Docker Compose内: postgresql://postgres:postgres@postgres:5432/cron_larning
# ローカルPostgreSQL直接接続: postgresql://postgres:postgres@localhost:5432/cron_larning
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/cron_larning

# ============================================
# 本番環境用（Railway/Vercel）
# ============================================
# Railwayで自動設定される環境変数:
# - DATABASE_URL (PostgreSQLサービスから自動生成)
# - PORT (Railwayが自動設定)
#
# 手動で設定する環境変数:
# - NODE_ENV=production
# - FRONTEND_URL=https://your-frontend-domain.vercel.app
#
# Vercelで設定する環境変数:
# - NEXT_PUBLIC_API_URL=https://your-api-url.up.railway.app

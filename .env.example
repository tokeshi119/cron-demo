# PostgreSQL設定
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cron_larning
POSTGRES_PORT=5432

# アプリケーション設定
NODE_ENV=development
APP_PORT=3000
FRONTEND_URL=http://localhost:3001

# データベース接続URL（Docker Compose内で使用）
# ローカル開発時: postgresql://postgres:postgres@localhost:5432/cron_larning
# Docker Compose内: postgresql://postgres:postgres@postgres:5432/cron_larning
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/cron_larning
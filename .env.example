# PostgreSQL設定
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cron_larning
POSTGRES_PORT=5432

# アプリケーション設定
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001

# データベース接続URL
# ローカル開発時（Docker Composeを使わない場合）: postgresql://postgres:postgres@localhost:5432/cron_larning
# Docker Compose内: postgresql://postgres:postgres@postgres:5432/cron_larning
# Prisma Cloud使用時: prisma+postgres://localhost:51213/?api_key=...
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/cron_larning